<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>UmaParser.Core.Tests</RootNamespace>
    <AssemblyName>UmaParser.Core.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\UmaParser.Core\UmaParser.Core.csproj" />
  </ItemGroup>

  <!--
    TracksViewModel does not use a window or a dispatcher. Compile it into this project so the
    tests run on Linux, where the WPF desktop runtime does not start. The WPF project compiles
    the same files for the app.
  -->
  <ItemGroup>
    <Compile Include="..\..\UmaParser.Wpf\Mvvm\ObservableObject.cs" Link="Linked\ObservableObject.cs" />
    <Compile Include="..\..\UmaParser.Wpf\ViewModels\TracksViewModel.cs" Link="Linked\TracksViewModel.cs" />
    <Compile Include="..\..\UmaParser.Wpf\ViewModels\ResultsViewModel.cs" Link="Linked\ResultsViewModel.cs" />
    <Compile Include="..\..\UmaParser.Wpf\ViewModels\AnalysisViewModel.cs" Link="Linked\AnalysisViewModel.cs" />
    <Compile Include="..\..\UmaParser.Wpf\ViewModels\OptionsViewModel.cs" Link="Linked\OptionsViewModel.cs" />
    <Compile Include="..\..\UmaParser.Wpf\Views\ResultsSheet.cs" Link="Linked\ResultsSheet.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
