<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      One mapping from CellBand to a brush. ARGB values are the light-mode AppColors
      palette (UmaParser/Ui/AppColors.cs). The converter looks up CellBand.{band}.Background
      and CellBand.{band}.Foreground. CellBand.None is not listed: the cell stays uncolored.

      Dark-mode values are below with a ".Dark" key. This window does not switch palettes
      yet. WinForms reads ColorMode from settings.json and restarts into a full dark theme
      (window, menus, grid chrome, and these bands). That shell theme is not ported.
    -->

    <SolidColorBrush x:Key="CellBand.Stable.Background" Color="#FF2E7D32"/>
    <SolidColorBrush x:Key="CellBand.Stable.Foreground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="CellBand.NeedsWork.Background" Color="#FFB4860B"/>
    <SolidColorBrush x:Key="CellBand.NeedsWork.Foreground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="CellBand.Critical.Background" Color="#FFB71C1C"/>
    <SolidColorBrush x:Key="CellBand.Critical.Foreground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="CellBand.Gold.Background" Color="#FFFFD700"/>
    <SolidColorBrush x:Key="CellBand.Gold.Foreground" Color="#FF000000"/>
    <SolidColorBrush x:Key="CellBand.Unique.Background" Color="#FFB0A6D2"/>
    <SolidColorBrush x:Key="CellBand.Unique.Foreground" Color="#FF000000"/>

    <!-- AppColors dark mode. Not selected by the window yet. -->
    <SolidColorBrush x:Key="CellBand.Dark.Stable.Background" Color="#FF43A047"/>
    <SolidColorBrush x:Key="CellBand.Dark.Stable.Foreground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="CellBand.Dark.NeedsWork.Background" Color="#FFFFB300"/>
    <SolidColorBrush x:Key="CellBand.Dark.NeedsWork.Foreground" Color="#FF000000"/>
    <SolidColorBrush x:Key="CellBand.Dark.Critical.Background" Color="#FFE53935"/>
    <SolidColorBrush x:Key="CellBand.Dark.Critical.Foreground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="CellBand.Dark.Gold.Background" Color="#FFFFC107"/>
    <SolidColorBrush x:Key="CellBand.Dark.Gold.Foreground" Color="#FF000000"/>
    <SolidColorBrush x:Key="CellBand.Dark.Unique.Background" Color="#FF8A80AF"/>
    <SolidColorBrush x:Key="CellBand.Dark.Unique.Foreground" Color="#FFFFFFFF"/>

</ResourceDictionary>
