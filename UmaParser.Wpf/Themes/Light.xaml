<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Light chrome. Named brushes are what the views and Controls.xaml look up.
      The SystemColors keys are the same colors, so default control templates follow this
      palette even when Windows itself is in dark mode.
      Window and menu colors match the WinForms system-color roles (control, window, highlight).
    -->

    <SolidColorBrush x:Key="Window.Background" Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="Window.Foreground" Color="#FF000000"/>
    <SolidColorBrush x:Key="Muted.Foreground" Color="#FF6D6D6D"/>
    <SolidColorBrush x:Key="Input.Background" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Input.Foreground" Color="#FF000000"/>
    <SolidColorBrush x:Key="Menu.Background" Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="Menu.Foreground" Color="#FF000000"/>
    <SolidColorBrush x:Key="Status.Background" Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="Status.Foreground" Color="#FF000000"/>
    <SolidColorBrush x:Key="Tab.InactiveBackground" Color="#FFE1E1E1"/>

    <SolidColorBrush x:Key="Grid.Background" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Grid.Foreground" Color="#FF000000"/>
    <SolidColorBrush x:Key="Grid.RowBackground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Grid.AlternatingRowBackground" Color="#FFF3F3F3"/>
    <SolidColorBrush x:Key="Grid.HeaderBackground" Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="Grid.HeaderForeground" Color="#FF000000"/>
    <SolidColorBrush x:Key="Grid.GridLine" Color="#FFD0D0D0"/>
    <SolidColorBrush x:Key="Grid.Border" Color="#FF688CAF"/>
    <SolidColorBrush x:Key="Grid.SelectionBackground" Color="#FF0078D7"/>
    <SolidColorBrush x:Key="Grid.SelectionForeground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Grid.InactiveSelectionBackground" Color="#FFB8D4F0"/>
    <SolidColorBrush x:Key="Grid.InactiveSelectionForeground" Color="#FF000000"/>

    <SolidColorBrush x:Key="Button.Background" Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="Button.Foreground" Color="#FF000000"/>
    <SolidColorBrush x:Key="Button.Border" Color="#FFABABAB"/>
    <SolidColorBrush x:Key="Button.HoverBackground" Color="#FFE5F1FB"/>
    <SolidColorBrush x:Key="Button.PressedBackground" Color="#FFCCE4F7"/>

    <SolidColorBrush x:Key="ScrollBar.Track" Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="ScrollBar.Thumb" Color="#FFC4C4C4"/>
    <SolidColorBrush x:Key="ScrollBar.ThumbHover" Color="#FFA6A6A6"/>

    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FF000000"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FF000000"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#FFE1E1E1"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}" Color="#FFF7F7F7"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#FFD0D0D0"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkDarkBrushKey}" Color="#FFABABAB"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#FF6D6D6D"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF0078D7"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FFB8D4F0"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FF000000"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#FF000000"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}" Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}" Color="#FF0078D7"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowFrameBrushKey}" Color="#FF688CAF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ActiveBorderBrushKey}" Color="#FF688CAF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveBorderBrushKey}" Color="#FFD0D0D0"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#FFFFF8D0"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#FF000000"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HotTrackBrushKey}" Color="#FF0078D7"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ScrollBarBrushKey}" Color="#FFF0F0F0"/>

    <!-- Performance chart. White skills stay pale, unique skills the darkest of the same gold family. -->
    <SolidColorBrush x:Key="Performance.Finish" Color="#FF3D7AB5"/>
    <SolidColorBrush x:Key="Performance.SkillWhite" Color="#FFF6E7A8"/>
    <SolidColorBrush x:Key="Performance.SkillGold" Color="#FFE0A020"/>
    <SolidColorBrush x:Key="Performance.SkillUnique" Color="#FF8C5A12"/>
    <SolidColorBrush x:Key="Performance.StrongStart" Color="#FF3E9B6D"/>
    <SolidColorBrush x:Key="Performance.StyleExtras" Color="#FF7A6BB5"/>
    <SolidColorBrush x:Key="Performance.Deduction" Color="#FFB54646"/>
    <SolidColorBrush x:Key="Performance.Spread" Color="#FF5C5C5C"/>
    <SolidColorBrush x:Key="Performance.Median" Color="#FF1A1A1A"/>
    <SolidColorBrush x:Key="Performance.P90" Color="#FFC4483A"/>
    <SolidColorBrush x:Key="Performance.TeamAverage" Color="#FF404040"/>
    <SolidColorBrush x:Key="Performance.Hover" Color="#140078D7"/>
    <SolidColorBrush x:Key="Performance.CurrentLineup" Color="#FF2B6CA3"/>
    <SolidColorBrush x:Key="Performance.SampleSoft" Color="#FF8A6A00"/>
    <SolidColorBrush x:Key="Performance.SampleHard" Color="#FFB42318"/>

</ResourceDictionary>
