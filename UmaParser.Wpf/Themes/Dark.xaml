<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Dark chrome. Window, menu, input, grid, and selection colors follow WinForms AppColors.
      Inactive selection is a dimmer filled blue so a row still reads as selected.
    -->

    <SolidColorBrush x:Key="Window.Background" Color="#FF202020"/>
    <SolidColorBrush x:Key="Window.Foreground" Color="#FFF1F1F1"/>
    <SolidColorBrush x:Key="Muted.Foreground" Color="#FFA0A0A0"/>
    <SolidColorBrush x:Key="Input.Background" Color="#FF2D2D30"/>
    <SolidColorBrush x:Key="Input.Foreground" Color="#FFF1F1F1"/>
    <SolidColorBrush x:Key="Menu.Background" Color="#FF2D2D30"/>
    <SolidColorBrush x:Key="Menu.Foreground" Color="#FFF1F1F1"/>
    <SolidColorBrush x:Key="Status.Background" Color="#FF2D2D30"/>
    <SolidColorBrush x:Key="Status.Foreground" Color="#FFF1F1F1"/>
    <SolidColorBrush x:Key="Tab.InactiveBackground" Color="#FF37373A"/>

    <SolidColorBrush x:Key="Grid.Background" Color="#FF202020"/>
    <SolidColorBrush x:Key="Grid.Foreground" Color="#FFF1F1F1"/>
    <SolidColorBrush x:Key="Grid.RowBackground" Color="#FF202020"/>
    <SolidColorBrush x:Key="Grid.AlternatingRowBackground" Color="#FF2A2A2D"/>
    <SolidColorBrush x:Key="Grid.HeaderBackground" Color="#FF37373A"/>
    <SolidColorBrush x:Key="Grid.HeaderForeground" Color="#FFF1F1F1"/>
    <SolidColorBrush x:Key="Grid.GridLine" Color="#FF46464A"/>
    <SolidColorBrush x:Key="Grid.Border" Color="#FF3F3F46"/>
    <SolidColorBrush x:Key="Grid.SelectionBackground" Color="#FF264F78"/>
    <SolidColorBrush x:Key="Grid.SelectionForeground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="Grid.InactiveSelectionBackground" Color="#FF3A5A78"/>
    <SolidColorBrush x:Key="Grid.InactiveSelectionForeground" Color="#FFF1F1F1"/>

    <SolidColorBrush x:Key="Button.Background" Color="#FF3A3A3D"/>
    <SolidColorBrush x:Key="Button.Foreground" Color="#FFF1F1F1"/>
    <SolidColorBrush x:Key="Button.Border" Color="#FF555555"/>
    <SolidColorBrush x:Key="Button.HoverBackground" Color="#FF4A4A4F"/>
    <SolidColorBrush x:Key="Button.PressedBackground" Color="#FF264F78"/>

    <SolidColorBrush x:Key="ScrollBar.Track" Color="#FF2A2A2D"/>
    <SolidColorBrush x:Key="ScrollBar.Thumb" Color="#FF5A5A5E"/>
    <SolidColorBrush x:Key="ScrollBar.ThumbHover" Color="#FF78787C"/>

    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FF202020"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFF1F1F1"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FF202020"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFF1F1F1"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#FF37373A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}" Color="#FF3F3F46"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkBrushKey}" Color="#FF46464A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlDarkDarkBrushKey}" Color="#FF555558"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#FFA0A0A0"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#FF264F78"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#FF3A5A78"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFF1F1F1"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FF2D2D30"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#FFF1F1F1"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}" Color="#FF2D2D30"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}" Color="#FF264F78"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowFrameBrushKey}" Color="#FF3F3F46"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ActiveBorderBrushKey}" Color="#FF3F3F46"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveBorderBrushKey}" Color="#FF3F3F46"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#FF2D2D30"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#FFF1F1F1"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HotTrackBrushKey}" Color="#FF3A9BFF"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ScrollBarBrushKey}" Color="#FF2A2A2D"/>

    <!-- Performance chart. White skills stay the lightest gold, unique skills the darkest. -->
    <SolidColorBrush x:Key="Performance.Finish" Color="#FF6BA6DE"/>
    <SolidColorBrush x:Key="Performance.SkillWhite" Color="#FFF0D78A"/>
    <SolidColorBrush x:Key="Performance.SkillGold" Color="#FFE8B23A"/>
    <SolidColorBrush x:Key="Performance.SkillUnique" Color="#FFC48A3A"/>
    <SolidColorBrush x:Key="Performance.StrongStart" Color="#FF5CBF8A"/>
    <SolidColorBrush x:Key="Performance.StyleExtras" Color="#FFB0A0E0"/>
    <SolidColorBrush x:Key="Performance.Deduction" Color="#FFE07070"/>
    <SolidColorBrush x:Key="Performance.Spread" Color="#FFD0D0D0"/>
    <SolidColorBrush x:Key="Performance.Median" Color="#FFF5F5F5"/>
    <SolidColorBrush x:Key="Performance.P90" Color="#FFFF8A78"/>
    <SolidColorBrush x:Key="Performance.TeamAverage" Color="#FFE8E8E8"/>
    <SolidColorBrush x:Key="Performance.Hover" Color="#33264F78"/>

</ResourceDictionary>
