<UserControl x:Class="UmaParser.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:UmaParser.Views">
    <Grid Margin="8">
        <TextBlock Text="{Binding Message}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   VerticalAlignment="Center"
                   Padding="24"
                   Foreground="{DynamicResource Muted.Foreground}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowGrid}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <!--
          Results is one column per file. A DataGrid realizes a cell control for each
          column that scrolls into view, and a track click does that for a whole screen.
          The sheet paints the visible window instead. The frame matches the Aero2 DataGrid border.
        -->
        <Border BorderBrush="{DynamicResource Grid.Border}" BorderThickness="1" Background="{DynamicResource Grid.Background}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowGrid}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <views:ResultsSheetView x:Name="Sheet" Grid.Row="0" Grid.Column="0"/>
                <ScrollBar x:Name="VerticalScroll"
                           Grid.Row="0"
                           Grid.Column="1"
                           Orientation="Vertical"
                           Focusable="False"
                           Visibility="Collapsed"/>
                <ScrollBar x:Name="HorizontalScroll"
                           Grid.Row="1"
                           Grid.Column="0"
                           Orientation="Horizontal"
                           Focusable="False"
                           Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
