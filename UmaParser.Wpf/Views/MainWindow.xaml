<Window x:Class="UmaParser.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:UmaParser.Behaviors"
        xmlns:views="clr-namespace:UmaParser.Views"
        xmlns:vm="clr-namespace:UmaParser.ViewModels"
        Title="Uma Parser"
        Height="720"
        Width="1100"
        MinHeight="480"
        MinWidth="640"
        Background="{DynamicResource Window.Background}"
        Foreground="{DynamicResource Window.Foreground}"
        behaviors:FileDropBehavior.Command="{Binding LoadFilesCommand}">
    <Window.Resources>
        <!--
          The tab control's content is a view model (ScreenTab.Content).
          WPF picks the view from that type. ResultsViewModel becomes ResultsView,
          and the view's DataContext is the view model.
          A new tab needs one more template here. It does not need a change to this rule.
          CachingTabControl keeps each view in the tree after the first visit.
        -->
        <DataTemplate DataType="{x:Type vm:ResultsViewModel}">
            <views:ResultsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AnalysisViewModel}">
            <views:AnalysisView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SkillsViewModel}">
            <views:SkillsView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TracksViewModel}">
            <views:TracksView/>
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Options">
                <MenuItem Header="Preferences..." Command="{Binding OpenPreferencesCommand}"/>
            </MenuItem>
            <MenuItem Header="View">
                <MenuItem x:Name="SystemThemeItem" Header="System" IsCheckable="True" Click="SystemTheme_Click"/>
                <MenuItem x:Name="LightThemeItem" Header="Light" IsCheckable="True" Click="LightTheme_Click"/>
                <MenuItem x:Name="DarkThemeItem" Header="Dark" IsCheckable="True" Click="DarkTheme_Click"/>
            </MenuItem>
            <MenuItem Header="Master Data">
                <MenuItem Header="Status..." Command="{Binding ShowMasterDataStatusCommand}"/>
                <MenuItem Header="Refresh" Command="{Binding RefreshMasterDataCommand}"/>
                <Separator/>
                <MenuItem Header="Use Default Location" Command="{Binding UseDefaultMasterDataCommand}"/>
                <MenuItem Header="Browse for master.mdb..." Command="{Binding BrowseMasterDataCommand}"/>
                <MenuItem Header="Open Default Master Folder" Command="{Binding OpenMasterDataFolderCommand}"/>
            </MenuItem>
        </Menu>
        <Border DockPanel.Dock="Bottom" Padding="8,6" Background="{DynamicResource Status.Background}">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="{DynamicResource Status.Foreground}"/>
        </Border>
        <views:CachingTabControl ItemsSource="{Binding Tabs}" SelectedIndex="{Binding SelectedTabIndex}">
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Title}" Margin="8,2" Foreground="{DynamicResource Window.Foreground}"/>
                </DataTemplate>
            </TabControl.ItemTemplate>
        </views:CachingTabControl>
    </DockPanel>
</Window>
