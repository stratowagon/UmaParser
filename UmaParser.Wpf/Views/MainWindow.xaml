<Window x:Class="UmaParser.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:UmaParser.Behaviors"
        xmlns:views="clr-namespace:UmaParser.Views"
        Title="Uma Parser"
        Height="720"
        Width="1100"
        MinHeight="480"
        MinWidth="720"
        behaviors:FileDropBehavior.Command="{Binding LoadFilesCommand}">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="8,6" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"/>
        </Border>
        <views:SkillsView DataContext="{Binding Skills}"/>
    </DockPanel>
</Window>
