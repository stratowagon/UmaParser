<Window x:Class="UmaParser.Views.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Options"
        Width="680"
        Height="520"
        MinWidth="640"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Window.Background}"
        Foreground="{DynamicResource Window.Foreground}">
    <TabControl Margin="8">
        <TabItem Header="Columns">
            <DockPanel Margin="8">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Apply" Width="80" Margin="0,0,8,0" Click="Apply_Click"/>
                    <Button Content="Cancel" Width="80" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
                    <Button Content="OK" Width="80" IsDefault="True" Click="Ok_Click"/>
                </StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ListBox Grid.Column="0"
                             ItemsSource="{Binding Grids}"
                             SelectedItem="{Binding SelectedGrid}"
                             DisplayMemberPath="DisplayName"/>
                    <DockPanel Grid.Column="2">
                        <TextBlock DockPanel.Dock="Top"
                                   Text="{Binding LockedColumnText}"
                                   Foreground="{DynamicResource Muted.Foreground}"
                                   Margin="0,0,0,6"/>
                        <TextBlock DockPanel.Dock="Bottom" Text="Description" Margin="0,8,0,2"/>
                        <TextBox DockPanel.Dock="Bottom"
                                 Text="{Binding Description, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Height="110"/>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Move Up" Width="90" IsEnabled="{Binding CanMoveUp}" Click="MoveUp_Click"/>
                            <Button Content="Move Down" Width="90" Margin="8,0,0,0" IsEnabled="{Binding CanMoveDown}" Click="MoveDown_Click"/>
                            <Button Content="Restore Defaults" Width="120" Margin="8,0,0,0" Click="RestoreDefaults_Click"/>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding Columns}" SelectedItem="{Binding SelectedColumn}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Left"
                                                  IsChecked="{Binding IsVisible, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsAvailable}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,6,0"
                                                  Focusable="False"/>
                                        <TextBlock Text="{Binding Header}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </DockPanel>
        </TabItem>
    </TabControl>
</Window>
